# .env.production
# File biến môi trường dành cho server/production khi chạy Docker.

# URL public của API mà trình duyệt sẽ gọi (Thường trỏ về chính tên miền thông qua Nginx proxy).
# Do Nginx đã cấu hình proxy /api/ sang backend, bạn có thể để nguyên "/api/v1".
NEXT_PUBLIC_API_URL=/api/v1

# Tắt Telemetry của Next.js
NEXT_TELEMETRY_DISABLED=1

# (Không cần MODEL_GDRIVE_ID nữa - model best9.onnx được COPY vào Docker image)

# (Tùy chọn) Cấu hình Database hoặc Auth Token Secret nếu Backend có hỗ trợ
# SECRET_KEY=your_secure_secret_here

# ── ML Library Warning Suppression ──────────────────────────────────────
# Các biến môi trường này giúp giảm noise trong log từ TensorFlow, matplotlib, v.v.
# TF_CPP_MIN_LOG_LEVEL=3
# MPLBACKEND=Agg
# MPLCONFIGDIR=/tmp/matplotlib
# KMP_WARNINGS=0
